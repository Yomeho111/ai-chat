# syntax=docker/dockerfile:1
FROM node:22-alpine AS frontend
RUN npm install --global pnpm@8.15.9
WORKDIR /src/ai-chat-web
COPY ai-chat-web/package.json ai-chat-web/pnpm-lock.yaml ai-chat-web/.npmrc ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY ai-chat-web/ ./
RUN pnpm run build-only

FROM golang:1.25-alpine AS backend
WORKDIR /src/ai-chat-backend
COPY ai-chat-backend/go.mod ai-chat-backend/go.sum ./
RUN go mod download
COPY ai-chat-backend/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -mod=readonly -o ai-chat-backend ./cmd

FROM alpine:3.22
RUN apk add --no-cache ca-certificates curl
WORKDIR /app
COPY ai-chat-backend/dev.config.yaml ./config.yaml
COPY --from=frontend /src/ai-chat-web/dist/ ./www/
COPY --from=backend /src/ai-chat-backend/ai-chat-backend ./
ENTRYPOINT ["./ai-chat-backend"]
CMD ["--config=config.yaml"]
